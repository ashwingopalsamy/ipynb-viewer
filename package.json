{
  "name": "ipynb-viewer",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:pages": "vite build --base=/ipynb-viewer/ && node tools/site.mjs --mirror",
    "deploy": "vite build && node tools/site.mjs && wrangler deploy",
    "deploy:dry": "vite build && node tools/site.mjs && wrangler deploy --dry-run",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "bench": "BENCH=1 vitest run src/lib/notebook/bench.test.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "katex": "^0.19.1",
    "marked": "^18.1.1",
    "shiki": "^4.5.0"
  }
}
