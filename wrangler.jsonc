{
  "name": "ipynb-viewer",
  "compatibility_date": "2026-04-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "ipynb.ashwingopalsamy.in", "custom_domain": true }],
  "main": "tools/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/link/*"]
  }
}
